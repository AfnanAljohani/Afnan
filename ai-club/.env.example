# EWA AI Club — environment variables
# Copy to .env.local for local development (never commit the real file).
# On Vercel: Project → Settings → Environment Variables.

# --- Supabase (Project Settings → API Keys) -------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_…): safe for browsers, protected by RLS.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…): SERVER ONLY. Used by /api for the library job,
# chat rate limiting and reading chatbot knowledge. Never put it in HTML/JS.
SUPABASE_SECRET_KEY=

# --- Daily library update ---------------------------------------------------
# Long random string (e.g. `openssl rand -hex 32`). The scheduler sends it as
# "Authorization: Bearer <CRON_SECRET>" to /api/cron/library.
CRON_SECRET=
# Max Arabic summaries generated by the model per run (0 = none)
LIBRARY_SUMMARY_LIMIT=20

# --- Ollama (club assistant + Arabic summaries) ----------------------------
# Base URL of an Ollama server reachable from Vercel over HTTPS, e.g.
#   https://ollama.com            (Ollama Cloud, needs OLLAMA_API_KEY)
#   https://ollama.your-domain.sa (your server behind a reverse proxy with auth)
# A laptop's http://localhost:11434 is NOT reachable by site visitors.
OLLAMA_URL=
OLLAMA_MODEL=
# Bearer token for Ollama Cloud or your reverse proxy (leave empty if none)
OLLAMA_API_KEY=
OLLAMA_TIMEOUT_MS=45000

# --- Assistant limits ------------------------------------------------------
CHAT_MAX_MESSAGE_CHARS=800
CHAT_MAX_TURNS=8
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_SECONDS=600
# Salt for hashing visitor IPs in the rate limiter (defaults to CRON_SECRET)
RATE_LIMIT_SALT=

# --- CORS --------------------------------------------------------------------
# The site calls its own /api (same origin, no CORS needed). List any other
# origins that may call the API from a browser, comma-separated.
ALLOWED_ORIGINS=https://ewa-ai.vercel.app
SITE_URL=https://ewa-ai.vercel.app
